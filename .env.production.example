# =========================
# APP CORE
# =========================

APP_NAME=GipAttendance
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dolebelison.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12


# =========================
# LOGGING
# =========================

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning


# =========================
# DATABASE
# =========================

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

MYSQL_ROOT_PASSWORD=


# =========================
# REMOTE DATABASE
# =========================

REMOTE_DB_HOST=
REMOTE_DB_PORT=3306
REMOTE_DB_DATABASE=
REMOTE_DB_USERNAME=
REMOTE_DB_PASSWORD=


# =========================
# SESSION
# =========================

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax


# =========================
# CACHE / QUEUE / PERMISSION
# =========================

CACHE_STORE=redis
QUEUE_CONNECTION=redis
PERMISSION_CACHE_STORE=redis


# =========================
# REDIS
# =========================

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379


# =========================
# BROADCASTING / REVERB
# =========================

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Internal Docker connection
REVERB_HOST=reverb
REVERB_SERVER_PORT=8080
REVERB_PORT=8080
REVERB_SCHEME=http


# =========================
# VITE / REVERB
# =========================

VITE_APP_NAME="${APP_NAME}"

# Public browser-facing Reverb connection
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=dolebelison.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https


# =========================
# MAIL
# =========================

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://dolebelison.com


# =========================
# AWS / S3
# =========================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# =========================
# BACKUPS
# =========================

BACKUP_MYSQLDUMP_PATH=
BACKUP_DESTINATION_PATH=
BACKUP_RETENTION_DAYS=14

BACKUP_ENCRYPT=true
BACKUP_ALWAYS_ENCRYPT_ENV=true
BACKUP_ENCRYPTION_KEY=


# =========================
# SECURITY
# =========================

JWT_SECRET=


# =========================
# DOCKER / STARTUP
# =========================

CHECK_DATABASE_ON_STARTUP=true